{
  "info": {
    "name": "Bharat Shikshak Backend",
    "description": "Import this collection, set baseUrl, then run Register or Login. Tests save bearerToken, classId and studentId automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "bearerToken", "value": "" },
    { "key": "classId", "value": "" },
    { "key": "studentId", "value": "" },
    { "key": "attendanceDate", "value": "2026-09-16" }
  ],
  "item": [
    {
      "name": "System",
      "item": [{
        "name": "Health Check",
        "request": { "method": "GET", "url": "http://localhost:5000/health" }
      }]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"employeeId\": \"POSTMAN-001\",\n  \"fullName\": \"Postman Test Teacher\",\n  \"schoolName\": \"Demo Government School\",\n  \"email\": \"postman.teacher@example.com\",\n  \"password\": \"password123\"\n}" },
            "url": "{{baseUrl}}/auth/register"
          },
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.test('Registration succeeded', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('bearerToken', body.token);"] } }]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"employeeId\": \"POSTMAN-001\",\n  \"password\": \"password123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["const body = pm.response.json();", "pm.test('Login succeeded', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('bearerToken', body.token);"] } }]
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" }
        }
      ]
    },
    {
      "name": "User",
      "item": [{
        "name": "Get My Profile",
        "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }], "url": "{{baseUrl}}/users/me" }
      }]
    },
    {
      "name": "Class",
      "item": [
        {
          "name": "Get My Classes",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }], "url": "{{baseUrl}}/classes" },
          "event": [{ "listen": "test", "script": { "exec": ["const classes = pm.response.json().data;", "if (classes?.length) pm.collectionVariables.set('classId', classes[0].id);"] } }]
        },
        {
          "name": "Get Class Students",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }], "url": "{{baseUrl}}/classes/{{classId}}/students" },
          "event": [{ "listen": "test", "script": { "exec": ["const students = pm.response.json().data;", "if (students?.length) pm.collectionVariables.set('studentId', students[0].id);"] } }]
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Mark Attendance",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"classId\": \"{{classId}}\",\n  \"date\": \"{{attendanceDate}}\",\n  \"records\": [{ \"studentId\": \"{{studentId}}\", \"status\": \"PRESENT\" }]\n}" }, "url": "{{baseUrl}}/attendance/mark" }
        },
        {
          "name": "Get Class Attendance",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }], "url": "{{baseUrl}}/attendance/class?classId={{classId}}&date={{attendanceDate}}" }
        }
      ]
    },
    {
      "name": "Library",
      "item": [
        {
          "name": "Add Resource",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Practice Worksheet\",\n  \"fileUrl\": \"https://example.com/worksheet.pdf\",\n  \"fileType\": \"PDF\",\n  \"classId\": \"{{classId}}\"\n}" }, "url": "{{baseUrl}}/library" }
        },
        {
          "name": "Get Resources",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }], "url": "{{baseUrl}}/library?classId={{classId}}" }
        }
      ]
    },
    {
      "name": "AI",
      "item": [{
        "name": "Ask Sahayak",
        "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"prompt\": \"Explain fractions with a classroom activity\",\n  \"gradeLevel\": \"Grade 5\"\n}" }, "url": "{{baseUrl}}/ai/ask" }
      }]
    }
  ]
}
